# === LLM — Cloudflare Workers AI (no OpenAI required) ===
# Preferred: proxy through Allma (uses the same Workers AI binding as chat)
BROWSER_AGENT_LLM_BASE_URL=https://allmasafetyai.online/api/browser-llm/v1
BROWSER_AGENT_LLM_API_KEY=same_as_VPS_AGENT_SECRET_TOKEN
BROWSER_AGENT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
BROWSER_AGENT_USE_VISION=false

# Fallback: Cloudflare Workers AI REST API
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_workers_ai_api_token

# Optional: OpenAI instead
# OPENAI_API_KEY=sk-...
# BROWSER_AGENT_MODEL=gpt-4o

# === Agent security ===
VPS_AGENT_SECRET_TOKEN=generate_a_random_32_byte_hex_token_here
VAULT_SECRET_KEY=generate_fernet_key_via_cryptography_Fernet_generate_key
VAULT_DB_PATH=/opt/allma-browser-agent/vault_store.enc
SCREENSHOT_DIR=/opt/allma-browser-agent/storage/screenshots
CORS_ALLOW_ORIGINS=*
